# Loaded by DotNetEnv before WebApplication.CreateBuilder.
# The appsettings.json defaults target local Azurite.
ConnectionStrings__AzureBlob=UseDevelopmentStorage=true
Media__Container=media
Procyon__Media__Provider=Azure
Procyon__Media__BaseUrl=http://127.0.0.1:10000/devstoreaccount1/media

# For an Azure Storage account, replace the connection string above in your
# untracked .env and set BaseUrl to the container's public URL.
# SAS URLs require an account-key connection string.
