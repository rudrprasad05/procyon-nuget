{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Procyon": {
    "Email": {
      "Enabled": true,
      "Provider": "Azure",
      "DefaultSender": {
        "Address": "no-reply@example.com",
        "Name": "Procyon Email Example"
      },
      "DefaultReplyTo": {
        "Address": "support@example.com",
        "Name": "Procyon Support"
      },
      "Delivery": {
        "TimeoutSeconds": 30,
        "MaximumRecipientsPerMessage": 50,
        "MaximumAttachmentSizeMb": 20
      },
      "Retry": {
        "Enabled": true,
        "MaximumAttempts": 3,
        "InitialDelaySeconds": 2,
        "UseExponentialBackoff": true,
        "RequireIdempotencyKey": true
      },
      "UnsupportedFeatureBehaviour": "Throw",
      "Logging": {
        "LogRecipients": false
      },
      "Azure": {
        "SenderEmail": "no-reply@procyon.local"
      }
    }
  }
}
